-- Logika Minimize
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinimizeBtn.Text = "+"
        MainFrame.Size = UDim2.new(0, 230, 0, 30)
        ScrollFrame.Visible = false
    else
        MinimizeBtn.Text = "-"
        MainFrame.Size = UDim2.new(0, 230, 0, 250)
        ScrollFrame.Visible = true
    end
end)

-- ==========================================
-- FUNGSI UI
-- ==========================================
local function createToggle(text)
    local btn = Instance.new("TextButton", ScrollFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Text = text .. " : OFF"
    btn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    return btn
end

local function createPointInput(placeholder)
    local frame = Instance.new("Frame", ScrollFrame)
    frame.Size = UDim2.new(0.9, 0, 0, 30)
    frame.BackgroundTransparency = 1
    local tb = Instance.new("TextBox", frame)
    tb.Size = UDim2.new(0.75, -5, 1, 0)
    tb.PlaceholderText = placeholder
    tb.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    tb.TextColor3 = Color3.fromRGB(255, 255, 255)
    tb.TextScaled = true
    local setBtn = Instance.new("TextButton", frame)
    setBtn.Size = UDim2.new(0.25, 0, 1, 0)
    setBtn.Position = UDim2.new(0.75, 5, 0, 0)
    setBtn.Text = "Set"
    setBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 150)
    setBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    setBtn.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local pos = char.HumanoidRootPart.Position
            tb.Text = math.floor(pos.X) .. "," .. math.floor(pos.Y) .. "," .. math.floor(pos.Z)
        end
    end)
    return tb
end

-- ==========================================
-- ELEMEN UI
-- ==========================================
local SpaceTop = Instance.new("Frame", ScrollFrame); SpaceTop.Size = UDim2.new(1,0,0,2); SpaceTop.BackgroundTransparency = 1

local ToggleClick = createToggle("Auto Klik Kiri")
local GardenPoint = createPointInput("Titik Garden (X, Y, Z)")
local ToggleTweenGarden = createToggle("Tween to Garden")
local ToggleInteract = createToggle("Auto Interact (E) [9]")

local SpaceDivider = Instance.new("Frame", ScrollFrame); SpaceDivider.Size = UDim2.new(0.9,0,0,2); SpaceDivider.BackgroundColor3 = Color3.fromRGB(100,100,100)

local Point1 = createPointInput("Titik 1 (X, Y, Z)")
local Point2 = createPointInput("Titik 2 (X, Y, Z)")
local Point3 = createPointInput("Titik 3 (X, Y, Z)")
local Point4 = createPointInput("Titik 4 (X, Y, Z)")
local ToggleWalk = createToggle("Auto Walk To [0]")

-- ==========================================
-- LOGIKA FITUR
-- ==========================================
local function toggleInteractLogic()
    isInteractOn = not isInteractOn
    ToggleInteract.Text = isInteractOn and "Auto Interact (E) [9] : ON" or "Auto Interact (E) [9] : OFF"
    ToggleInteract.BackgroundColor3 = isInteractOn and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(50, 150, 50)
end

-- FUNGSI AUTO WALK TO DIKEMBALIKAN
local function toggleWalkLogic()
    isAutoWalkOn = not isAutoWalkOn
    ToggleWalk.Text = isAutoWalkOn and "Auto Walk To [0] : ON" or "Auto Walk To [0] : OFF"
    ToggleWalk.BackgroundColor3 = isAutoWalkOn and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(50, 150, 50)

    if isAutoWalkOn then
        task.spawn(function()
            -- Sistem Auto Jump
            task.spawn(function()
                while isAutoWalkOn do
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                    
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then hum.Jump = true end
                    
                    task.wait(1.95)
                end
            end)

            -- Sistem Pergerakan Patroli
            while isAutoWalkOn do
                local textInputs = {Point1.Text, Point2.Text, Point3.Text, Point4.Text}
                
                for i = 1, 4 do
                    if not isAutoWalkOn then break end
                    
                    local str = textInputs[i]
                    local x, y, z = str:match("([%-?%d%.]+)%s*,%s*([%-?%d%.]+)%s*,%s*([%-?%d%.]+)")
                    
                    if x and y and z then
                        local targetPos = Vector3.new(tonumber(x), tonumber(y), tonumber(z))
                        local char = LocalPlayer.Character
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        
                        if hum then
                            hum:MoveTo(targetPos)
                            
                            local reached = false
                            local connection
                            connection = hum.MoveToFinished:Connect(function() reached = true end)
                            
                            local timeout = 0
                            while not reached and isAutoWalkOn and timeout < 80 do
                                task.wait(0.1)
                                timeout = timeout + 1
                            end
                            
                            if connection then connection:Disconnect() end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    else
        -- Berhenti ketika dimatikan
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and char:FindFirstChild("HumanoidRootPart") then
            hum:MoveTo(char.HumanoidRootPart.Position)
        end
    end
end

local function toggleTweenGardenLogic()
    isTweenGardenOn = not isTweenGardenOn
    ToggleTweenGarden.Text = isTweenGardenOn and "Tween to Garden : ON" or "Tween to Garden : OFF"
    ToggleTweenGarden.BackgroundColor3 = isTweenGardenOn and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(50, 150, 50)

    if isTweenGardenOn then
        task.spawn(function()
            local str = GardenPoint.Text
            local x, y, z = str:match("([%-?%d%.]+)%s*,%s*([%-?%d%.]+)%s*,%s*([%-?%d%.]+)")
            if x and y and z then
                local targetPos = Vector3.new(tonumber(x), tonumber(y), tonumber(z))
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum then
                    hum.PlatformStand = true
                    local tweenSpeed = 30
                    
                    local function runTween(targetCFrame)
                        local dist = (hrp.Position - targetCFrame.Position).Magnitude
                        local time = dist / tweenSpeed
                        local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
                        currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
                        currentTween:Play()
                        
                        while isTweenGardenOn and currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing do
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            task.wait(0.05)
                        end
                    end

                    local startPos = hrp.Position
                    runTween(CFrame.new(Vector3.new(startPos.X, targetPos.Y, startPos.Z)))
                    if isTweenGardenOn then runTween(CFrame.new(targetPos)) end
                    
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hum.PlatformStand = false
                    isTweenGardenOn = false
                    ToggleTweenGarden.Text = "Tween to Garden : OFF"
                    ToggleTweenGarden.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
                end
            else
                isTweenGardenOn = false
                ToggleTweenGarden.Text = "Tween to Garden : OFF"
            end
        end)
    else
        if currentTween then currentTween:Cancel(); currentTween = nil end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

-- ==========================================
-- EVENT HANDLERS & KEYBINDS DIKEMBALIKAN
-- ==========================================
ToggleInteract.MouseButton1Click:Connect(toggleInteractLogic)
ToggleWalk.MouseButton1Click:Connect(toggleWalkLogic)
ToggleTweenGarden.MouseButton1Click:Connect(toggleTweenGardenLogic)

ToggleClick.MouseButton1Click:Connect(function()
    isAutoClickOn = not isAutoClickOn
    ToggleClick.Text = isAutoClickOn and "Auto Klik Kiri : ON" or "Auto Klik Kiri : OFF"
    ToggleClick.BackgroundColor3 = isAutoClickOn and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(50, 150, 50)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end 
    if input.KeyCode == Enum.KeyCode.Nine then
        toggleInteractLogic()
    elseif input.KeyCode == Enum.KeyCode.Zero then
        toggleWalkLogic()
    end
end)

-- SPAM E ULTRA FAST
RunService.RenderStepped:Connect(function()
    if isInteractOn then
        for _ = 1, 3 do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
    end
end)

-- AUTO CLICK LOOP
task.spawn(function()
    while true do
        if isAutoClickOn then
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
            end
            pcall(function() if mouse1click then mouse1click() end end)
        end
        task.wait(60)
    end
end)
