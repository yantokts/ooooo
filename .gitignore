-- Status Fitur
local isInteractOn = false
local isAutoClickOn = false
local isAutoWalkOn = false
local isTweenGardenOn = false
local isMinimized = false
local currentTween = nil

-- ==========================================
-- MEMBUAT GUI UTAMA
-- ==========================================
local SpeedHubGui = Instance.new("ScreenGui")
