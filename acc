-- ==========================================
-- LOGIKA 3: AUTO SELL (JEDA 10 DETIK & EQUIP)
-- ==========================================
task.spawn(function()
    while true do
        if _G.AutoSellEnabled then
            local character = LocalPlayer.Character
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            
            if character and backpack then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                
                local itemToSell = nil
                
                -- Cari item yang sedang di-equip (di dalam Character) yang ada kata "Box"
                for _, item in ipairs(character:GetChildren()) do
                    if item:IsA("Tool") and string.find(item.Name, "Box") then
                        itemToSell = item
                        break
                    end
                end
                
                -- Jika belum di-equip, cari di dalam Backpack
                if not itemToSell then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") and string.find(item.Name, "Box") then
                            itemToSell = item
                            break
                        end
                    end
                end
                
                if itemToSell and humanoid and rootPart then
                    -- Equip item secara otomatis jika posisinya masih di inventory/Backpack
                    if itemToSell.Parent == backpack then
                        humanoid:EquipTool(itemToSell)
                        task.wait(0.2) -- Jeda sebentar agar sistem game mendeteksi tool sudah ter-equip
                    end
                    
                    -- Cari bagian SellPart untuk dijual
                    local plots = workspace:FindFirstChild("MAP") and workspace.MAP:FindFirstChild("Plots")
                    if plots then
                        for _, plotFolder in ipairs(plots:GetChildren()) do
                            local plotN0 = plotFolder:FindFirstChild("Plot_N0")
                            if plotN0 then
                                local sellPart = plotN0:FindFirstChild("SellPart")
                                if sellPart then
                                    -- Eksekusi jual: Menyentuh SellPart secara virtual
                                    if firetouchinterest then
                                        firetouchinterest(rootPart, sellPart, 0)
                                        task.wait(0.1)
                                        firetouchinterest(rootPart, sellPart, 1)
                                    else
                                        local prompt = sellPart:FindFirstChildWhichIsA("ProximityPrompt", true)
                                        if prompt then
                                            prompt.MaxActivationDistance = 9e9
                                            prompt.RequiresLineOfSight = false
                                            if fireproximityprompt then
                                                fireproximityprompt(prompt)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            task.wait(10)
        else
            task.wait(1)
        end
    end
end)
