-- Nama file untuk menyimpan konfigurasi
local configFileName = "QueueTyper_SavedConfig_V2.json"

-- Data konfigurasi default
local configData = {
    username = "",
    autoSpamEnabled = false,
    autoJoinEnabled = false,
    followUserEnabled = true
}

-- Fungsi untuk menyimpan data ke file executor
local function saveConfig()
    pcall(function()
        if writefile then
            writefile(configFileName, HttpService:JSONEncode(configData))
        end
    end)
end

-- Fungsi untuk memuat data dari file saat rejoin/start
local function loadConfig()
    pcall(function()
        if readfile and isfile and isfile(configFileName) then
            local content = readfile(configFileName)
            local decoded = HttpService:JSONDecode(content)
            if type(decoded) == "table" then
                if decoded.username then configData.username = decoded.username end
                if decoded.autoSpamEnabled ~= nil then configData.autoSpamEnabled = decoded.autoSpamEnabled end
                if decoded.autoJoinEnabled ~= nil then configData.autoJoinEnabled = decoded.autoJoinEnabled end
                if decoded.followUserEnabled ~= nil then configData.followUserEnabled = decoded.followUserEnabled end
            end
        end
    end)
end

loadConfig()

