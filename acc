-- ==========================================
-- LOGIKA 1: FAST EXECUTION (CLICK & BUY)
-- ==========================================
task.spawn(function()
    while true do
        if not (_G.AutoClickEnabled or _G.AutoBuyPackEnabled) then
            task.wait(0.1)
            continue
        end

        local plots = workspace:FindFirstChild("MAP") and workspace.MAP:FindFirstChild("Plots")
        if not plots then
            task.wait(0.1)
            continue
        end

        local targetPackFound = nil
        local targetPrompt = nil

        for _, plotFolder in ipairs(plots:GetChildren()) do
            local plotN0 = plotFolder:FindFirstChild("Plot_N0")
            if plotN0 then
                local conveyor = plotN0:FindFirstChild("LocalConveyorModels")
                if conveyor then
                    local pack = conveyor:FindFirstChild(_G.TargetPackName)
                    if pack then
                        targetPackFound = pack
                        targetPrompt = pack:FindFirstChildWhichIsA("ProximityPrompt", true)
                        break
                    end
                end
            end
        end

        if targetPackFound then
            if _G.AutoBuyPackEnabled and targetPrompt then
                targetPrompt.MaxActivationDistance = 9e9
                targetPrompt.RequiresLineOfSight = false
                
                if fireproximityprompt then
                    fireproximityprompt(targetPrompt)
                elseif targetPrompt.InputHoldBegin then
                    targetPrompt:InputHoldBegin()
                    task.wait(targetPrompt.HoldDuration or 0)
                    targetPrompt:InputHoldEnd()
                end
            end
            task.wait() 
        else
            if _G.AutoClickEnabled then
                for _, plotFolder in ipairs(plots:GetChildren()) do
                    local plotN0 = plotFolder:FindFirstChild("Plot_N0")
                    if plotN0 then
                        local buttonPart = plotN0:FindFirstChild("ButtonPart")
                        if buttonPart then
                            local clickDetector = buttonPart:FindFirstChildWhichIsA("ClickDetector")
                            if clickDetector and fireclickdetector then
                                fireclickdetector(clickDetector)
                            end
                        end
                    end
                end
                task.wait(0.03)
            else
                task.wait(0.1)
            end
        end
    end
end)

