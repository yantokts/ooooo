-- Fungsi Kirim Teks ke Path Target & Sinkronisasi Follow Username
local function applyUsername()
    local targetText = UsernameBox.Text
    configData.username = targetText
    saveConfig()

    pcall(function()
        local pGui = player:WaitForChild("PlayerGui", 2)
        if not pGui then return end
        
        local queueGui = pGui:FindFirstChild("queueGui")
        if not queueGui then return end
        local gameSearch = queueGui:FindFirstChild("gameSearch")
        if not gameSearch then return end
        local joinRequest = gameSearch:FindFirstChild("joinRequest")
        if not joinRequest then return end
        local usernameField = joinRequest:FindFirstChild("usernameField")
        if not usernameField then return end
        local usernameBoxTarget = usernameField:FindFirstChild("usernameBox")
        if not usernameBoxTarget then return end
        
        if usernameBoxTarget:IsA("TextBox") then
            -- Hanya update jika teks berbeda agar tidak bentrok dengan ketikan manual user
            if usernameBoxTarget.Text ~= targetText then
                usernameBoxTarget.Text = targetText
            end
            usernameBoxTarget.Active = true
        end
    end)
end

UsernameBox.FocusLost:Connect(function()
    applyUsername()
end)

-- Tombol Toggle Builder
local function createToggleUI(name, defaultState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = defaultState and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(40, 40, 50)
    btn.Text = name .. ": " .. (defaultState and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Font = Enum.Font.Code
    btn.Parent = ContentContainer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local state = defaultState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(40, 40, 50)
        btn.Text = name .. ": " .. (state and "ON" or "OFF")
        callback(state)
    end)
    return btn
end

local function pressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- Fungsi Klik yang Dipaksa Aktif Terus
local function clickGuiObject(guiObject)
    if not guiObject then return end
    pcall(function()
        guiObject.Active = true
        if firesignal then
            firesignal(guiObject.MouseButton1Click)
        end
        if guiObject.Activated then
            firesignal(guiObject.Activated)
        end
    end)
end

-- FITUR 0: Follow Username Loop (Secara berkala memastikan kotak input game sama persis dengan yang diketik)
task.spawn(function()
    while true do
        if configData.followUserEnabled and configData.username ~= "" then
            pcall(function()
                applyUsername()
            end)
        end
        task.wait(0.5)
    end
end)

-- FITUR 1: Auto Spam Q & E (Looping)
task.spawn(function()
    while true do
        if configData.autoSpamEnabled then
            pcall(function()
                applyUsername()
                pressKey(Enum.KeyCode.Q)
                task.wait(1)
                if configData.autoSpamEnabled then
                    pressKey(Enum.KeyCode.E)
                end
            end)
        end
        task.wait(1)
    end
end)

-- FITUR 2: Auto Spam Join Request (Looping Tanpa Henti Setiap 1 Detik)
task.spawn(function()
    while true do
        if configData.autoJoinEnabled then
            pcall(function()
                applyUsername()
                
                local targetTextButton = nil
                
                -- Cek di PlayerGui terlebih dahulu
                local pGui = player:FindFirstChild("PlayerGui")
                if pGui then
                    local qGui = pGui:FindFirstChild("queueGui")
                    if qGui then
                        local gSearch = qGui:FindFirstChild("gameSearch")
                        if gSearch then
                            local jReq = gSearch:FindFirstChild("joinRequest")
                            if jReq then
                                local sReq = jReq:FindFirstChild("sendRequest")
                                if sReq then
                                    targetTextButton = sReq:FindFirstChild("TextButton")
                                end
                            end
                        end
                    end
                end
                
                -- Fallback ke StarterGui jika belum ada di PlayerGui
                if not targetTextButton then
                    local sQueueGui = StarterGui:FindFirstChild("queueGui")
                    if sQueueGui then
                        local sGameSearch = sQueueGui:FindFirstChild("gameSearch")
                        if sGameSearch then
                            local sJoinReq = sGameSearch:FindFirstChild("joinRequest")
                            if sJoinReq then
                                local sSendReq = sJoinReq:FindFirstChild("sendRequest")
                                if sSendReq then
                                    targetTextButton = sSendReq:FindFirstChild("TextButton")
                                end
                            end
                        end
                    end
                end
                
                if targetTextButton then
                    clickGuiObject(targetTextButton)
                end
            end)
        end
        task.wait(1.0) -- Pastikan loop terus berjalan setiap 1 detik
    end
end)

